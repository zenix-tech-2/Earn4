# Public Supabase project credentials (anon key is safe in browser code with strict RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# PayLinky is the selected payment provider. Checkout stays disabled until its official
# checkout and signed-webhook contract is reviewed and implemented server-side.
PAYMENT_PROVIDER=paylinky
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
